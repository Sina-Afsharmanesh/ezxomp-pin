{
  "name": "ezxomp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "import": "bun run scripts/import-upstreams.ts -- --all",
    "import:check": "bun run scripts/import-upstreams.ts -- verify",
    "check": "bunx tsc --noEmit",
    "test:plugins": "bun test test/",
    "smoke:plugins": "bun test test/smoke-plugins.test.ts",
    "smoke:codesight-tui": "bun test test/smoke-codesight-tui.test.ts",
    "smoke:workflowz": "bun run test/smoke-workflowz.test.ts",
    "verify:omp": "bun run scripts/verify-omp.ts",
    "install:local": "bun run scripts/install-local.ts",
    "list:local": "omp plugin list --json"
  },
  "allowScripts": {
    "koffi": true,
    "@google/genai": true,
    "protobufjs": true
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.0.6",
    "@oh-my-pi/pi-ai": "18.0.6",
    "@oh-my-pi/pi-coding-agent": "18.0.6",
    "@oh-my-pi/pi-tui": "18.0.6",
    "@oh-my-pi/pi-utils": "18.0.6",
    "@types/bun": "1.3.14",
    "typebox": "1.1.38"
  }
}
