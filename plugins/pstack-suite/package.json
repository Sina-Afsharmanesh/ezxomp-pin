{
  "name": "@ezxomp/pstack-suite",
  "version": "1.0.0-ezxomp.0",
  "description": "Unified agent workflows: code quality, PR review, docs, CI, team ops",
  "keywords": [
    "omp-package",
    "omp-extension",
    "pstack",
    "coding-agent",
    "ai"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "skills/",
    "agents/",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "settings": {
      "defaultModel": {
        "type": "string",
        "description": "Default model for agents when pstack-models.json is not configured"
      }
    }
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "18.0.6",
    "@oh-my-pi/pi-coding-agent": "18.0.6",
    "@oh-my-pi/pi-tui": "18.0.6"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/tmp": "^0.2.6",
    "@vitest/coverage-v8": "^4.1.11",
    "tmp": "^0.2.7",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "RUN_LIVE=1 vitest run --config vitest.live.config.ts",
    "test:smoke": "RUN_SMOKE=1 vitest run --config vitest.smoke.config.ts"
  }
}
