{
  "name": "@ezxomp/augment",
  "version": "1.0.9-ezxomp.1",
  "description": "Augment-style prompt rewriter for OMP — one command, stronger prompts",
  "keywords": [
    "omp-package",
    "omp-extension",
    "prompt-enhancer",
    "prompt-engineering",
    "coding-agent",
    "ai"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "src/index.ts"
    ],
    "settings": {
      "rewriteMode": {
        "type": "enum",
        "default": "auto",
        "values": ["auto", "plain", "execution-contract"]
      },
      "maxOutputTokens": {
        "type": "number",
        "default": 1200,
        "min": 1,
        "step": 1
      },
      "timeoutMs": {
        "type": "number",
        "default": 45000,
        "min": 1,
        "step": 1
      },
      "conversationContextDepth": {
        "type": "number",
        "default": 4,
        "min": 0,
        "step": 1
      },
      "outputStyleFamily": {
        "type": "enum",
        "default": "auto",
        "values": ["auto", "claude", "gpt"]
      },
      "reviewBeforeSend": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sting8k/pi-augment.git"
  },
  "homepage": "https://github.com/sting8k/pi-augment#readme",
  "bugs": {
    "url": "https://github.com/sting8k/pi-augment/issues"
  },
  "dependencies": {
    "@ezxomp/experiences": "workspace:*"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "18.0.6",
    "@oh-my-pi/pi-coding-agent": "18.0.6",
    "@oh-my-pi/pi-tui": "18.0.6"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  }
}
